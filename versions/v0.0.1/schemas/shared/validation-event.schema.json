{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-protocol.dev/schemas/v0.0.1/shared/validation-event.schema.json",
  "title": "ValidationEvent",
  "description": "A typed record of a machine validation step against a protocol entity or patch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["validatedAt", "validator", "status"],
  "properties": {
    "validatedAt": { "type": "string", "format": "date-time" },
    "validator": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "message": { "type": "string" }
  }
}
