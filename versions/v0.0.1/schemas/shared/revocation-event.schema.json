{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-protocol.dev/schemas/v0.0.1/shared/revocation-event.schema.json",
  "title": "RevocationEvent",
  "description": "A typed record of a revocation. Forward-compatible stub formally specified in v0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["revokedAt", "revokedBy", "reason"],
  "properties": {
    "revokedAt": { "type": "string", "format": "date-time" },
    "revokedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorType", "actorId"],
      "properties": {
        "actorType": {
          "type": "string",
          "enum": ["principal", "user", "system", "agent"]
        },
        "actorId": { "type": "string", "minLength": 1 }
      }
    },
    "reason": { "type": "string", "minLength": 1 },
    "evidenceEventIds": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
